# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed — this file (.env.example) only holds
# placeholders and is safe to commit.

RTSP_URL=rtsp://username:password@camera-ip:554/stream-path

# HTTP Basic Auth for every Flask app in this project (app.py, cctv_stream.py,
# cctv_stream_gst.py, local_camera_stream.py). Pick a real password before
# deploying — this gate is the only thing standing between the camera feed
# and anyone on the same network.
WEB_USERNAME=admin
WEB_PASSWORD=change-this-password
